# Variables para el stack de Portainer (docker-compose.prod.yml). Cargarlas en
# Portainer → Stack → Environment variables; no commitear valores reales.

# === Requeridas
# Tiene que ser https: sin TLS la cookie de sesión no se guarda.
POSTIZ_URL=https://postiz.siux.co
# openssl rand -hex 32
JWT_SECRET=
# Postgres del servidor, con base y usuario propios de Postiz. Clave en hex
# (openssl rand -hex 24): caracteres como @ : / # rompen la URL.
DATABASE_URL=postgresql://postiz:CLAVE@postgres:5432/postiz
# Red de Docker donde están Postgres y MinIO (la misma que usa tarotia.app).
SHARED_NETWORK=backend_net
# Opcional. Redis del servidor con un número de base libre (1-15) para no mezclar claves
# con otras apps, ej. redis://redis:6379/3. Vacío, Postiz usa un reemplazo en memoria.
REDIS_URL=
# Temporal corre embebido en la imagen (base SQLite en el volumen /config): no lleva variables.

# === MinIO (archivos subidos). Mismas variables que tarotia.app, bucket y claves propios.
# Conexión interna, sin SSL: nombre del contenedor/host en SHARED_NETWORK.
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=postiz
MINIO_REGION=us-east-1
# URL pública https de la API de MinIO (proxy → MinIO:9000), sin barra final.
# El navegador sube ahí y las redes bajan de MINIO_PUBLIC_URL/MINIO_BUCKET_NAME.
MINIO_PUBLIC_URL=https://s3.sv00.siux.co

# === Opcionales
# Puerto del host al que apunta el proxy (cambiar si 5000 está ocupado).
POSTIZ_PORT=5000
# Imagen del fork (siux-build.yaml). La oficial de gitroomhq no soporta MinIO.
POSTIZ_IMAGE=ghcr.io/siuxco/postiz-app:latest
DISABLE_REGISTRATION=true

# === Redes
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
X_API_KEY=
X_API_SECRET=

# === Email (recuperación de contraseña, invitaciones)
# Dejar EMAIL_PROVIDER vacío hasta tener RESEND_API_KEY y EMAIL_FROM_ADDRESS: con un
# proveedor configurado Postiz pide activar la cuenta por email, y si el envío falla
# el primer usuario no puede entrar.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM_NAME=Postiz
EMAIL_FROM_ADDRESS=
